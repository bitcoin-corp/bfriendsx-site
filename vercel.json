{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.bfriendsx.com"
        }
      ],
      "destination": "https://bfriendsx.com/",
      "permanent": true
    },
    {
      "source": "/link/x",
      "destination": "https://bmintx.com/link/x?return=bfriendsx",
      "permanent": false
    },
    {
      "source": "/flick-off",
      "destination": "https://bmintx.com/flick-off",
      "permanent": false
    },
    {
      "source": "/flick-off/:path*",
      "destination": "https://bmintx.com/flick-off/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bfriendsx.com"
        }
      ],
      "destination": "https://bfriendsx.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/i/:t",
      "destination": "/invite"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/bwalletx-theme.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
