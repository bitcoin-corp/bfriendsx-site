{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/link/x",
      "destination": "https://bmintx.com/link/x?return=bfriendsx",
      "permanent": false
    },
    {
      "source": "/flick-off",
      "destination": "https://bmintx.com/flick-off",
      "permanent": false
    },
    {
      "source": "/flick-off/:path*",
      "destination": "https://bmintx.com/flick-off/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bfriendsx.com"
        }
      ],
      "destination": "https://bfriendsx.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/i/:t",
      "destination": "/invite"
    }
  ]
}
